# Copy to examples/vtex_poc/.env (gitignored) and fill in. Public storefront APIs only:
# there is no app key or app token, and the agent never asks for credentials.

# Required
VTEX_ACCOUNT=
VTEX_DOMAIN=
VTEX_SC=
VTEX_SELLER=

# Optional (defaults shown)
# VTEX_ENVIRONMENT=vtexcommercestable
# VTEX_LOCALE=pt-BR
# VTEX_COUNTRY=BRA
# VTEX_CURRENCY=BRL
# VTEX_TIMEOUT_SECONDS=10
# VTEX_MAX_RETRIES=3
